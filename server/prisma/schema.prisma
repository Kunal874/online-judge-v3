// Prisma schema — grows incrementally as each milestone needs new models.
// See PLAN.md for the milestone sequence.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  handle        String   @unique
  name          String
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)

  // Hashed the same way passwordHash is — a DB leak shouldn't hand out usable tokens.
  // Deliberately not @unique, unlike the link tokens: a 6-digit code has only
  // a million values, so two users can legitimately hold the same one at once
  // and a unique index would make the second request fail at random.
  emailOtpHash     String?
  emailOtpExpires  DateTime?
  // Counts wrong guesses against the current code. Six digits is only ~20
  // bits, so without a cap an attacker could simply walk the whole range.
  emailOtpAttempts Int       @default(0)
  // When the last code was sent, so resend can be throttled per account
  // rather than only per IP.
  emailOtpSentAt   DateTime?

  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  registrations ContestRegistration[]
  hintReveals   HintReveal[]

  @@index([email])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  statement     String
  difficulty    Difficulty
  tags          String[]
  constraints   String?
  timeLimitMs   Int        @default(2000)
  memoryLimitKb Int        @default(262144)
  isPublished   Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testCases       TestCase[]
  submissions     Submission[]
  contestProblems ContestProblem[]
  hints           ProblemHint[]
  hintReveals     HintReveal[]

  @@index([difficulty])
  @@index([tags], type: Gin)
}

// isHidden:false rows ARE the "sample test cases" shown on the problem
// page — no separate sampleTestCases table needed, one model covers both.
model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean @default(true)
  orderIndex     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results TestCaseResult[]

  @@index([problemId])
}

enum Language {
  CPP
  C
  JAVA
  PYTHON
}

enum Verdict {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  Language
  code      String
  verdict   Verdict  @default(PENDING)

  // Truncated compiler/internal error only — never a raw stack trace.
  errorMessage String?
  runtimeMs    Int? // max across test cases
  memoryKb     Int? // max across test cases
  passedCount  Int  @default(0)
  totalCount   Int  @default(0)

  // Set only when the submission was made inside a running contest the user
  // had registered for — the API refuses to set it otherwise. Nulled rather
  // than deleted if the contest is removed, so a user keeps their history.
  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results TestCaseResult[]

  @@index([userId, createdAt])
  @@index([userId, problemId])
  @@index([contestId, createdAt])
}

// Deliberately has no input/expectedOutput/actualOutput fields — only
// pass/fail + index + resource usage, so this table structurally cannot
// leak hidden test case content regardless of who queries it.
model TestCaseResult {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId   String
  testCase     TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  orderIndex   Int
  verdict      Verdict
  runtimeMs    Int?
  memoryKb     Int?

  @@index([submissionId])
}

model Contest {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  startsAt    DateTime
  endsAt      DateTime
  isPublished Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems      ContestProblem[]
  registrations ContestRegistration[]
  submissions   Submission[]

  @@index([startsAt])
}

// A join table rather than a contestId on Problem: the same problem can be
// reused across contests and also live in the public pool, and the
// contest-specific bits (display label, point value, ordering within the
// set) describe the pairing, not the problem itself.
model ContestProblem {
  id         String  @id @default(cuid())
  contestId  String
  contest    Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  // "A", "B", "C" — how the problem is referred to during the contest.
  label      String
  points     Int     @default(100)
  orderIndex Int     @default(0)

  createdAt DateTime @default(now())

  // A problem appears at most once per contest, and labels are unique
  // within a contest — both enforced in the database rather than only in
  // application code, since a duplicate would corrupt the leaderboard.
  @@unique([contestId, problemId])
  @@unique([contestId, label])
  @@index([contestId])
}

model ContestRegistration {
  id           String   @id @default(cuid())
  contestId    String
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([contestId, userId])
  @@index([contestId])
}

// A curriculum expressed as a directed graph rather than an ordered list.
// The useful question isn't "what comes after chapter 6", it's "what stands
// between me and lazy propagation" — which is a path query, and only
// answerable if prerequisites are edges.
model Concept {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  blurb   String
  /// Rough ordering hint for layout when two concepts sit at the same graph
  /// depth. Not a curriculum position — the edges decide that.
  tier    Int     @default(0)

  // Self-relation through an explicit join model: an edge carries no data
  // today, but naming it keeps "prerequisite of" readable in queries.
  prerequisiteOf ConceptEdge[] @relation("prerequisite")
  requires       ConceptEdge[] @relation("dependent")

  @@index([slug])
}

model ConceptEdge {
  id String @id @default(cuid())

  /// The concept that must come first.
  prerequisiteId String
  prerequisite   Concept @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  /// The concept it unlocks.
  dependentId String
  dependent   Concept @relation("dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  // A prerequisite stated twice is the same statement, and the leaderboard
  // of a graph is its shape — duplicates would distort every route length.
  @@unique([prerequisiteId, dependentId])
  @@index([dependentId])
}

// The stuck ladder: graded nudges, from a reframing to the full approach.
// Stored per problem rather than inline in the statement so a rung can be
// withheld until it is asked for — the whole mechanism is pointless if
// every hint ships to the browser with the problem.
model ProblemHint {
  id         String  @id @default(cuid())
  problemId  String
  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// 0-based rung. Lower rungs reframe; the last one gives the approach away.
  orderIndex Int
  /// A few words on what kind of help this is — "reframe", "the recurrence".
  label      String
  body       String

  @@unique([problemId, orderIndex])
  @@index([problemId])
}

// Which rungs a user has opened. Logged, not charged: nothing is deducted
// for asking, but a solve that needed the full editorial is not the same
// achievement as one that didn't, and only a record can tell them apart.
model HintReveal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId  String
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  orderIndex Int
  revealedAt DateTime @default(now())

  // Re-opening a rung already seen is not a second reveal.
  @@unique([userId, problemId, orderIndex])
  @@index([userId, problemId])
}
