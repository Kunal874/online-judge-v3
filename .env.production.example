# Copy to `.env` beside docker-compose.prod.yml and fill in real values.
# See DEPLOYMENT.md. Every value here is required — the compose file fails
# fast rather than falling back to a default secret.

POSTGRES_USER=judge
POSTGRES_PASSWORD=
POSTGRES_DB=online_judge

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every session — the intended global logout.
JWT_SECRET=

# The public hostname Caddy obtains a TLS certificate for. Must already
# resolve to this server, and must be a name, not an IP — no public
# certificate authority will issue a certificate for a bare IP address.
# With no domain of your own, sslip.io resolves any IP for free:
#   server IP 203.0.113.5  ->  SITE_ADDRESS=203-0-113-5.sslip.io
SITE_ADDRESS=judge.example.com

# Public origin of the site, used for CORS and for links in emails.
# Same host as SITE_ADDRESS, with the scheme.
FRONTEND_URL=https://judge.example.com

# getent group docker | cut -d: -f3
# Lets the worker read the Docker socket without running as root.
DOCKER_GID=

# Concurrent judging jobs per worker. Each one is a container, so this is
# bounded by host CPU and RAM.
WORKER_CONCURRENCY=2

# "lax" is correct when the API is served under /api on the app's origin,
# which is what docker-compose.prod.yml does. Only use "none" for a
# genuinely cross-domain API; it gives up SameSite as a CSRF defense.
COOKIE_SAMESITE=lax

# Leave blank and nothing is delivered — verification codes and password
# reset emails silently go nowhere. Set these before launch.
#
# Gmail works without a paid plan: turn on 2-Step Verification, then create
# an App Password (myaccount.google.com/apppasswords) and use that as
# SMTP_PASS — your normal Google password will be rejected.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The mail's From address. Leave blank and it defaults to SMTP_USER — the
# account actually authenticated above, and the only address that account's
# own SPF/DKIM/DMARC cover. Sending mail that claims a different address
# than the one that authenticated is a spoofing signature, and is why a
# judge sending through a real Gmail account under a made-up From address
# lands in spam regardless of how the receiving side is configured. Only
# set this once you own a domain and have configured *that* domain's DNS to
# authorize this server to send as it.
SMTP_FROM=

# Require a verified email before running or submitting code. Reading
# problems and leaderboards stays open either way.
#
# The API refuses to start if this is true while SMTP_HOST is blank —
# otherwise no code can ever be delivered, so no account can ever be
# verified, and every user is locked out of the judge.
REQUIRE_EMAIL_VERIFICATION=false
