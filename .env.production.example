# Copy to `.env` beside docker-compose.prod.yml and fill in real values.
# See DEPLOYMENT.md. Every value here is required — the compose file fails
# fast rather than falling back to a default secret.

POSTGRES_USER=judge
POSTGRES_PASSWORD=
POSTGRES_DB=online_judge

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every session — the intended global logout.
JWT_SECRET=

# Public origin of the site, used for CORS and for links in emails.
FRONTEND_URL=https://judge.example.com

# Host port nginx is published on. Terminate TLS in front of it.
WEB_PORT=8080

# getent group docker | cut -d: -f3
# Lets the worker read the Docker socket without running as root.
DOCKER_GID=

# Concurrent judging jobs per worker. Each one is a container, so this is
# bounded by host CPU and RAM.
WORKER_CONCURRENCY=2

# "lax" is correct when the API is served under /api on the app's origin,
# which is what docker-compose.prod.yml does. Only use "none" for a
# genuinely cross-domain API; it gives up SameSite as a CSRF defense.
COOKIE_SAMESITE=lax

# Leave blank and nothing is delivered — verification and password reset
# emails silently go nowhere. Set these before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
